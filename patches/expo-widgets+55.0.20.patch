+  // Inject ExpoUI bundle — JS 런타임을 여러 위치/구조에서 탐색 (위젯 extension 호환)
+  func loadWidgetBundleJS() -> String? {
+    let bundles = Bundle.allBundles + Bundle.allFrameworks + [Bundle.main]
+    for base in bundles {
+      guard let topURL = base.url(forResource: "ExpoWidgets", withExtension: "bundle") else {
+        continue
+      }
+      // 1) 평면 구조: ExpoWidgets.bundle 자체가 JS 파일
+      if let js = try? String(contentsOf: topURL, encoding: .utf8), !js.isEmpty {
+        return js
+      }
+      // 2) 중첩 구조: ExpoWidgets.bundle 디렉토리 안의 ExpoWidgets.bundle 파일
+      if let nested = Bundle(url: topURL),
+         let jsURL = nested.url(forResource: "ExpoWidgets", withExtension: "bundle"),
+         let js = try? String(contentsOf: jsURL, encoding: .utf8), !js.isEmpty {
+        return js
+      }
+    }
+    return nil
+  }
+
+  guard let bundleJS = loadWidgetBundleJS() else {
     print("[ExpoWidgets] Missing ExpoWidgets.bundle")
     return nil
   }
